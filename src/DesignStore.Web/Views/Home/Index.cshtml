@model HomePageData
@{ ViewData["Title"] = "Autorský design pro život"; ViewData["Description"] = "Originální nábytek, svítidla a kožené doplňky z našeho ateliéru."; var culture = ViewContext.RouteData.Values["culture"]; }
<section class="hero"><div class="hero-image" role="img" aria-label="Ručně vyráběný designový interiér"></div><div class="hero-copy"><p class="eyebrow">Ateliér · Morava</p><h1>Objekty, které<br />zůstávají.</h1><p>Navrhujeme a vyrábíme nábytek, světla a kožené doplňky s respektem k materiálu.</p><a class="button light" asp-controller="Catalog" asp-action="Index" asp-route-culture="@culture">Prohlédnout kolekci</a></div></section>
<section class="intro" id="story"><p class="eyebrow">Wild Spirit</p><h2>Věříme v pomalý design.<br />V charakter materiálu a doteku ruky.</h2><p>Každý předmět vzniká v malé sérii nebo jako jediný kus. Nehoníme sezóny — tvoříme věci, které přirozeně stárnou s vámi.</p></section>
<section class="section"><header class="section-head"><div><p class="eyebrow">Objevte</p><h2>Kolekce</h2></div><a asp-controller="Catalog" asp-action="Index" asp-route-culture="@culture">Zobrazit vše →</a></header><div class="category-grid">@foreach(var item in Model.Categories.Take(4)){<a class="category-card" asp-controller="Catalog" asp-action="Index" asp-route-culture="@culture" asp-route-categoryId="@item.Id"><img src="@item.ImageUrl" alt="@item.Name" loading="lazy" /><span>@item.Name</span></a>}</div></section>
<partial name="_ProductSection" model='("Vybrané kusy", "Doporučujeme", Model.Featured)' />
<section id="craft" class="craft"><div class="craft-image"></div><div><p class="eyebrow">Ručně vyrobeno</p><h2>Od první skici<br />po poslední steh.</h2><p>Pracujeme s dubovým dřevem, černěným železem, kamenem a třísločiněnou kůží. Každý materiál necháváme stárnout s grácií.</p><ol><li><span>01</span>Návrh a prototyp</li><li><span>02</span>Výběr materiálu</li><li><span>03</span>Ruční zpracování</li><li><span>04</span>Kontrola a podpis</li></ol></div></section>
<partial name="_ProductSection" model='("Čerstvě z ateliéru", "Novinky", Model.NewProducts)' />
<section class="materials"><p class="eyebrow">Paleta ateliéru</p><h2>Dřevo. Železo. Kámen.</h2><div><article><h3>Dřevo</h3><p>Teplý dub a ořech s viditelnou kresbou, olejované do hlubokých sépiových tónů.</p></article><article><h3>Železo</h3><p>Ručně černěné povrchy, jemné stopy ohně a matná hloubka poctivého kovu.</p></article><article><h3>Kámen</h3><p>Vápenec a travertin s přirozenou strukturou, které každému kusu dávají klid a váhu.</p></article></div></section>
<partial name="_ProductSection" model='("Číslované série", "Limitované", Model.Limited)' />
<section class="newsletter"><p class="eyebrow">Dopisy z ateliéru</p><h2>Nové objekty. Nové příběhy.</h2><p>Jednou za čas vám pošleme pohled do dílny.</p><form><label class="sr-only" for="newsletter">E-mail</label><input id="newsletter" type="email" placeholder="váš@email.cz" disabled /><button type="button" disabled>Přihlásit se</button></form><small>Newsletter bude aktivován v Etapě 6.</small></section>
