@model ProductDetail
@{
    ViewData["Title"] = Model.Name;
    ViewData["Description"] = Model.Description;
    var culture = ViewContext.RouteData.Values["culture"];
}

<section class="product-detail" data-testid="product-detail" data-product-id="@Model.Id">
    <div class="detail-gallery" data-product-gallery>
        @if (Model.Images.Count > 0)
        {
            var mainImage = Model.Images.FirstOrDefault(x => x.IsPrimary) ?? Model.Images.First();
            <figure class="detail-main-media">
                <img src="/media/product/@mainImage.Id" alt="@mainImage.AltText" loading="eager" data-product-gallery-main />
            </figure>
            @if (Model.Images.Count > 1)
            {
                <div class="detail-thumbnails" aria-label="Fotografie produktu">
                    @for (var i = 0; i < Model.Images.Count; i++)
                    {
                        var image = Model.Images[i];
                        var isActive = image.Id == mainImage.Id;
                        <button type="button" class="detail-thumbnail @(isActive ? "is-active" : "")" data-product-thumb data-src="/media/product/@image.Id" data-alt="@image.AltText" aria-label="Zobrazit fotografii @(i + 1)" aria-current="@(isActive ? "true" : "false")">
                            <img src="/media/product/@image.Id?thumbnail=true" alt="@image.AltText" loading="lazy" />
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <figure class="detail-main-media">
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            </figure>
        }
    </div>
    <div class="detail-copy">
        <p class="eyebrow">@Model.CategoryName</p>
        <h1 data-testid="product-detail-title">@Model.Name</h1>
        <p class="lead">@Model.Description</p>
        <p class="detail-price" data-base-price="@Model.Price">@(Model.StartingPrice.HasValue ? $"od {Model.StartingPrice:N0} Kč" : $"{Model.Price:N0} Kč")</p>

        @if (TempData["Error"] is string error)
        {
            <p class="validation-summary-errors">@error</p>
        }

        @if (Model.CanAddToCart)
        {
            <form asp-controller="Cart" asp-action="Add" asp-route-culture="@culture" method="post" class="add-cart-form" data-testid="add-to-cart-form">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                @if (Model.Variants.Count > 0)
                {
                    <label for="variant">Varianta</label>
                    <select id="variant" name="ProductVariantId" required>
                        <option value="">Vyberte variantu</option>
                        @foreach (var v in Model.Variants.Where(x => x.Availability == AvailabilityStatus.InStock && x.StockQuantity > 0))
                        {
                            <option value="@v.Id">@v.Name · @v.Price.ToString("N0") Kč</option>
                        }
                    </select>
                }
                @for (var index = 0; index < Model.Options.Count; index++)
                {
                    var option = Model.Options[index];
                    <input type="hidden" name="Configuration[@index].ProductOptionId" value="@option.Id" />
                    <label for="option-@option.Id">@option.Name @(option.IsRequired ? "*" : "")</label>
                    @if (option.Type == ProductOptionType.Select)
                    {
                        <select id="option-@option.Id" name="Configuration[@index].ProductOptionValueId" class="product-option" required="@option.IsRequired">
                            <option value="" data-price="0">Vyberte</option>
                            @foreach (var value in option.Values)
                            {
                                <option value="@value.Id" data-price="@value.PriceAdjustment">@value.Name @(value.PriceAdjustment == 0 ? "" : $"+ {value.PriceAdjustment:N0} Kč")</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="option-@option.Id" name="Configuration[@index].CustomText" maxlength="@option.MaximumTextLength" required="@option.IsRequired" />
                    }
                }
                <label>Množství<input type="number" name="Quantity" value="1" min="1" max="99" data-testid="cart-quantity" /></label>
                <p class="availability in-stock">Skladem</p>
                <button class="button" type="submit" data-testid="add-to-cart-button">Přidat do košíku</button>
            </form>
        }
        else
        {
            @switch (Model.Availability)
            {
                case AvailabilityStatus.MadeToOrder:
                    <p class="availability made">Na objednávku · přibližně @Model.ProductionDays dní</p>
                    @if (Model.CanRequestProduction)
                    {
                        <a class="button" asp-controller="Inquiry" asp-action="Create" asp-route-culture="@culture" asp-route-productId="@Model.Id" data-testid="inquiry-link">Poptat výrobu</a>
                    }
                    break;
                case AvailabilityStatus.Unavailable:
                    <p class="availability">Momentálně nedostupné</p>
                    break;
                case AvailabilityStatus.Discontinued:
                    <p class="availability">Výroba ukončena</p>
                    break;
            }
        }

        <div class="detail-facts">
            <details open><summary>Popis</summary><p>@Model.LongDescription</p></details>
            <details><summary>Materiály a rozměry</summary><p>@Model.Materials</p><p>@Model.Dimensions</p></details>
            <details><summary>Péče a doprava</summary><p>@Model.Care</p><p>@Model.Shipping</p></details>
        </div>
    </div>
</section>

<section class="product-story">
    <p class="eyebrow">Příběh objektu</p>
    <h2>@Model.Story</h2>
</section>
