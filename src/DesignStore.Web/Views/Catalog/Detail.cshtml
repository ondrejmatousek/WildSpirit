@model ProductDetail
@{ ViewData["Title"] = Model.Name; ViewData["Description"] = Model.Description; }
<section class="product-detail"><div class="detail-gallery"><img src="@Model.ImageUrl" alt="@Model.Name" /></div><div class="detail-copy"><p class="eyebrow">@Model.CategoryName</p><h1>@Model.Name</h1><p class="lead">@Model.Description</p><p class="detail-price">@(Model.StartingPrice.HasValue ? $"od {Model.StartingPrice:N0} Kč" : $"{Model.Price:N0} Kč")</p>
@if(Model.Variants.Count>0){<label for="variant">Varianta</label><select id="variant">@foreach(var v in Model.Variants){<option disabled="@(v.Availability is AvailabilityStatus.Unavailable or AvailabilityStatus.Discontinued)">@v.Name · @v.Price.ToString("N0") Kč</option>}</select>}
@switch(Model.Availability){case AvailabilityStatus.InStock:<p class="availability in-stock">Skladem</p><button class="button" type="button" disabled>Přidat do košíku</button><small>Košík bude aktivován v Etapě 3.</small>break;case AvailabilityStatus.MadeToOrder:<p class="availability made">Na objednávku · přibližně @Model.ProductionDays dní</p><button class="button" type="button" disabled>Poptat výrobu</button><small>Poptávkový proces bude aktivován v Etapě 4.</small>break;case AvailabilityStatus.Unavailable:<p class="availability">Momentálně nedostupné</p>break;case AvailabilityStatus.Discontinued:<p class="availability">Výroba ukončena</p>break;}
<div class="detail-facts"><details open><summary>Popis</summary><p>@Model.LongDescription</p></details><details><summary>Materiály a rozměry</summary><p>@Model.Materials</p><p>@Model.Dimensions</p></details><details><summary>Péče a doprava</summary><p>@Model.Care</p><p>@Model.Shipping</p></details></div></div></section><section class="product-story"><p class="eyebrow">Příběh objektu</p><h2>@Model.Story</h2></section>
