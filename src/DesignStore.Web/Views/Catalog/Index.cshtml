@model IReadOnlyList
<ProductCard>
    @{
        ViewData["Title"] = "Kolekce";
        var categories = (IReadOnlyList
        <CategoryCard>)ViewBag.Categories;
            var culture = ViewContext.RouteData.Values["culture"];
        }

        <section class="page-heading">
            <p class="eyebrow">Wild Spirit</p>
            <h1>Kolekce</h1>
            <p>Autorské objekty vytvářené pomalu, pečlivě a v malých sériích.</p>
        </section>

        <nav class="filters" aria-label="Kategorie">
            <a asp-action="Index" asp-route-culture="@culture">Vše</a>
            @foreach (var c in categories)
            {
                <a asp-action="Index" asp-route-culture="@culture" asp-route-categoryId="@c.Id">@c.Name</a>
            }
        </nav>

        <section class="section">
            <div class="product-grid" data-testid="public-product-grid">
                @foreach (var item in Model)
                {
                    <article class="product-card" data-testid="public-product-card" data-product-id="@item.Id">
                        <a asp-action="Detail" asp-route-culture="@culture" asp-route-slug="@item.Slug" data-testid="public-product-link">
                            <div class="product-image">
                                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                @if (item.IsLimited)
                                {
                                    <span class="badge">Limitovaná série</span>
                                }
                            </div>
                            <p class="eyebrow">@item.CategoryName</p>
                            <h2>@item.Name</h2>
                            <p>@item.Description</p>
                            <p class="price">@(item.StartingPrice.HasValue ? $"od {item.StartingPrice:N0} Kč" : $"{item.Price:N0} Kč")</p>
                        </a>
                    </article>
                }
            </div>
        </section>
