@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "cs-CZ";
    var canSeeAdmin = User.IsInRole("Administrator") || User.IsInRole("ContentManager");
}
<nav class="account-nav" aria-label="Uživatelský účet">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-area="" asp-controller="Account" asp-action="Index" asp-route-culture="@culture">Můj účet</a>
        @if (canSeeAdmin)
        {
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" asp-route-culture="@culture">Administrace</a>
        }
        <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-culture="@culture" method="post"><button type="submit">Odhlásit</button></form>
    }
    else
    {
        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-culture="@culture">Přihlásit</a>
    }
</nav>
