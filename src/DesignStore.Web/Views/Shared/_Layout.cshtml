<!DOCTYPE html><html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="@ViewData["Description"]" /><title>@ViewData["Title"] · Wild Spirit</title><link rel="preconnect" href="https://images.unsplash.com" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<a class="skip-link" href="#main">Přejít na obsah</a><header class="site-header"><a class="brand" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]">WILD <span>SPIRIT</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button><nav id="main-nav" class="main-nav" aria-label="Hlavní navigace"><a asp-controller="Catalog" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]">Kolekce</a><a href="#craft">Řemeslo</a><a href="#story">Příběh</a><a href="#contact">Kontakt</a></nav><nav class="language-nav" aria-label="Jazyk"><a href="/cs-CZ">CZ</a><a href="/en">EN</a><a href="/de">DE</a></nav></header>
<main id="main">@RenderBody()</main><footer id="contact" class="site-footer"><div><p class="brand">WILD <span>SPIRIT</span></p><p>Autorský design. Poctivé materiály. Věci s charakterem.</p></div><div><p class="eyebrow">Ateliér</p><p>Morava · Česká republika<br />studio@wildspirit.design</p></div><div><p class="eyebrow">Informace</p><a asp-controller="Home" asp-action="Privacy" asp-route-culture="@ViewContext.RouteData.Values["culture"]">Ochrana soukromí</a></div><small>© @DateTime.UtcNow.Year Wild Spirit</small></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
