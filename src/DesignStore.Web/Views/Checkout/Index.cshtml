@using DesignStore.Application.Commerce
@using DesignStore.Domain.Commerce
@model CheckoutRequest
@{ViewData["Title"]="Pokladna";var cart=(CartView)ViewBag.Cart;}
<section class="catalog-header"><p class="eyebrow">Bezpečné dokončení</p><h1>Pokladna</h1><p>Částka bude před vytvořením objednávky znovu spočítána na serveru.</p></section>
<form method="post" class="checkout-form"><div asp-validation-summary="All"></div><input asp-for="IdempotencyKey" type="hidden"/><label>E-mail<input asp-for="Email" autocomplete="email"/></label><fieldset><legend>Fakturační adresa</legend><label>Jméno<input asp-for="BillingAddress.FullName"/></label><label>Firma<input asp-for="BillingAddress.Company"/></label><label>Ulice<input asp-for="BillingAddress.Street"/></label><label>Město<input asp-for="BillingAddress.City"/></label><label>PSČ<input asp-for="BillingAddress.PostalCode"/></label><label>Země<input asp-for="BillingAddress.CountryCode" maxlength="2"/></label><label>Telefon<input asp-for="BillingAddress.Phone"/></label></fieldset><label><input asp-for="UseBillingAsShipping"/> Dodací adresa je stejná</label><fieldset><legend>Dodací adresa (pokud je jiná)</legend><label>Jméno<input asp-for="ShippingAddress.FullName"/></label><label>Ulice<input asp-for="ShippingAddress.Street"/></label><label>Město<input asp-for="ShippingAddress.City"/></label><label>PSČ<input asp-for="ShippingAddress.PostalCode"/></label><label>Země<input asp-for="ShippingAddress.CountryCode" maxlength="2"/></label></fieldset><fieldset><legend>Doprava</legend><label><input asp-for="ShippingMethod" type="radio" value="standard" checked/> Kurýr 250 Kč</label><label><input asp-for="ShippingMethod" type="radio" value="pickup"/> Osobní odběr zdarma</label></fieldset><fieldset><legend>Platba</legend><label><input asp-for="PaymentMethod" type="radio" value="BankTransfer" checked/> Bankovní převod</label>@if((bool)ViewBag.AllowTestPayment){<label><input asp-for="PaymentMethod" type="radio" value="Test"/> Testovací platba</label>}</fieldset><strong>K úhradě včetně zvolené dopravy: od @cart.Total.ToString("N0") Kč</strong><button class="button" type="submit">Objednat s povinností platby</button></form>
