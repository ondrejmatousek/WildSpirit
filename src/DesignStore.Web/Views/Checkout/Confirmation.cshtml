@using DesignStore.Domain.Commerce
@model DesignStore.Application.Commerce.OrderDetail
@{
    ViewData["Title"] = "Objednávka přijata";
    var paymentStatus = Model.PaymentStatus switch
    {
        PaymentStatus.Pending => "Čeká na platbu",
        PaymentStatus.Paid => "Zaplaceno",
        PaymentStatus.Failed => "Platba selhala",
        PaymentStatus.Cancelled => "Platba zrušena",
        _ => Model.PaymentStatus.ToString()
    };
}

<section class="catalog-header order-confirmation-header">
    <p class="eyebrow">Děkujeme</p>
    <h1>Objednávka @Model.Number byla přijata</h1>
    <p>Stav platby: @paymentStatus</p>
    <strong>@Model.Total.ToString("N0") @Model.Currency</strong>
</section>

@if (TempData["Error"] is string paymentError)
{
    <p class="validation-summary-errors" role="alert">@paymentError</p>
}

@if (Model.PaymentMethod == PaymentMethod.Card && Model.Status == OrderStatus.PendingPayment && Model.PaymentStatus != PaymentStatus.Paid)
{
    <section class="section card-payment">
        @if (ViewBag.PaymentReturn as string == "success")
        {
            <p data-testid="card-payment-processing">Platbu ověřujeme. Stav objednávky se aktualizuje během několika okamžiků – stránku můžete obnovit.</p>
        }
        else
        {
            @if (ViewBag.PaymentReturn as string == "cancelled")
            {
                <p>Platba nebyla dokončena. Můžete ji zkusit znovu.</p>
            }
            @if ((bool)ViewBag.AllowCardPayment)
            {
                <form method="post" asp-action="Pay" asp-route-culture="@Context.GetRouteValue("culture")" asp-route-id="@Model.Id">
                    <input type="hidden" name="token" value="@ViewBag.AccessToken" />
                    <button class="button" type="submit" data-testid="card-payment-retry">Zaplatit kartou</button>
                </form>
            }
        }
    </section>
}

@if (Model.GiftVoucherCodes.Count > 0)
{
    <section class="section gift-voucher-result">
        <div class="section-heading">
            <p class="eyebrow">Dárkový poukaz</p>
            <h2>Váš kód</h2>
            <p>
                Kód zadejte při dalším nákupu do pole „Slevový kód nebo dárkový poukaz“.
            </p>
        </div>
        <div class="gift-voucher-code-grid">
            @foreach (var voucher in Model.GiftVoucherCodes)
            {
                <article class="gift-voucher-code-card">
                    <span>@voucher.Value.ToString("N0") @Model.Currency</span>
                    <strong>@voucher.Code</strong>
                    <p>
                        @(voucher.IsActive ? "Aktivní a připravený k použití." : "Aktivuje se po zaplacení objednávky.")
                    </p>
                </article>
            }
        </div>
    </section>
}
