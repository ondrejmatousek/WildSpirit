@model DesignStore.Web.Controllers.LoginModel
@{ ViewData["Title"] = "Přihlášení"; }
<section class="auth-shell">
    <div class="auth-visual" role="img" aria-label="Vintage interiér s koženým křeslem"><div class="auth-visual-copy"><p class="eyebrow">Wild Spirit Members</p><p>Váš výběr.<br />Váš příběh.</p></div></div>
    <div class="auth-panel"><div class="auth-card">
        <p class="eyebrow">Vítejte zpět</p><h1>Přihlášení</h1><p class="auth-intro">Vstupte do svého účtu nebo do správy ateliéru.</p>
        @if (TempData["Error"] is string error){<p class="validation-summary-errors">@error</p>}
        <form asp-action="Login" method="post" class="login-form" data-testid="login-form">
            <input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="validation"></div>
            <label asp-for="Email">E-mailová adresa</label><input asp-for="Email" autocomplete="username" placeholder="vas@email.cz" data-testid="login-email" />
            <label asp-for="Password">Heslo</label><input asp-for="Password" autocomplete="current-password" placeholder="Vaše heslo" data-testid="login-password" />
            <label class="check-row"><input asp-for="RememberMe" /><span>Zapamatovat přihlášení</span></label><button class="button button-wide" type="submit" data-testid="login-submit">Přihlásit se</button>
        </form>
        @if (ViewBag.ExternalLogins is IEnumerable<Microsoft.AspNetCore.Authentication.AuthenticationScheme> externalLogins && externalLogins.Any())
        {<div class="external-login"><div class="external-divider"><span>nebo</span></div>@foreach (var provider in externalLogins){<form asp-action="ExternalLogin" method="post"><input type="hidden" name="provider" value="@provider.Name"/><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="google-signin-button" type="submit"><span class="google-g-mark" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.4-.18-2.06H12v3.9h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.7 2.91-4.2 2.91-7.23z"/><path fill="#34A853" d="M12 21.7c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.7-1.72-5.47-4.03H3.28v2.53A9.74 9.74 0 0 0 12 21.7z"/><path fill="#FBBC05" d="M6.53 13.78A5.86 5.86 0 0 1 6.22 12c0-.62.11-1.22.31-1.78V7.69H3.28A9.74 9.74 0 0 0 2.25 12c0 1.57.38 3.06 1.03 4.31l3.25-2.53z"/><path fill="#EA4335" d="M12 6.19c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 3.22 14.63 2.3 12 2.3a9.74 9.74 0 0 0-8.72 5.39l3.25 2.53c.77-2.31 2.93-4.03 5.47-4.03z"/></svg></span><span>Sign in with @provider.DisplayName</span></button></form>}</div>}
        else {<p class="auth-note">Externí přihlášení se zobrazí po nastavení OAuth.</p>}
        <p class="auth-note">Potřebujete pomoc? Napište na <a href="mailto:studio@wildspirit.design">studio@wildspirit.design</a>.</p>
    </div></div>
</section>
