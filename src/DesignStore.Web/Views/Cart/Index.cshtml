@model DesignStore.Application.Commerce.CartView
@{
    ViewData["Title"] = "Košík";
    var culture = ViewContext.RouteData.Values["culture"];
}

<section class="catalog-header">
    <p class="eyebrow">Nákup</p>
    <h1>Košík</h1>
</section>

@if (TempData["Error"] is string error)
{
    <p class="validation-summary-errors">@error</p>
}
@if (TempData["Success"] is string ok)
{
    <p>@ok</p>
}

<section class="cart-page" data-testid="cart-page">
    @if (Model.Items.Count == 0)
    {
        <p data-testid="cart-empty">Košík je prázdný.</p>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            <article class="cart-line" data-testid="cart-line">
                <img src="@item.ImageUrl" alt="" />
                <div>
                    <h2>@item.Name</h2>
                    <p>@item.Variant @item.Sku</p>
                    @foreach (var c in item.Configuration)
                    {
                        <small>@c</small>
                    }
                </div>
                <form asp-action="Quantity" asp-route-culture="@culture" method="post">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <input type="number" name="quantity" min="1" max="99" value="@item.Quantity" />
                    <button type="submit">Upravit</button>
                </form>
                <strong>@item.Total.ToString("N0") Kč</strong>
                <form asp-action="Remove" asp-route-culture="@culture" method="post">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <button type="submit">Odstranit</button>
                </form>
            </article>
        }
        <form asp-action="Discount" asp-route-culture="@culture" method="post">
            <label>Slevový kód <input name="code" value="@Model.DiscountCode" /></label>
            <button type="submit">Použít</button>
        </form>
        <div class="cart-total">
            <p>Mezisoučet @Model.Subtotal.ToString("N0") Kč</p>
            <p>Sleva −@Model.Discount.ToString("N0") Kč</p>
            <strong>Celkem @Model.Total.ToString("N0") Kč</strong>
            <a class="button" asp-controller="Checkout" asp-action="Index" asp-route-culture="@culture">Pokračovat k pokladně</a>
        </div>
    }
</section>
