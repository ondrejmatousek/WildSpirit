@model IReadOnlyList<DesignStore.Application.Commerce.OrderListItem>
    @{
        ViewData["Title"] = "Objednávky";
    }

    <div class="admin-heading">
        <div>
            <p class="admin-kicker">Prodej</p>
            <h1>Objednávky</h1>
        </div>
    </div>

    <section class="admin-card order-list-card">
        @if (Model.Count == 0)
        {
            <p class="admin-empty">Zatím tu není žádná objednávka.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table order-table">
                    <thead>
                        <tr>
                            <th>Číslo</th>
                            <th>Datum</th>
                            <th>Zákazník</th>
                            <th>Stav</th>
                            <th>Platba</th>
                            <th class="number-cell">Celkem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>
                                    <a class="order-number" asp-action="Detail" asp-route-id="@order.Id">@order.Number</a>
                                </td>
                                <td>@order.CreatedAtUtc.ToLocalTime().ToString("d. M. yyyy HH:mm")</td>
                                <td>@order.Email</td>
                                <td>
                                    <span class="status-badge">@order.Status</span>
                                </td>
                                <td>
                                    <span class="status-badge muted">@order.PaymentStatus</span>
                                </td>
                                <td class="number-cell">@order.Total.ToString("N0") @order.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
