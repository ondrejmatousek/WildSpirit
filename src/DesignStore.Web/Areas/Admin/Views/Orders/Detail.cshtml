@using DesignStore.Domain.Commerce
@model DesignStore.Application.Commerce.OrderDetail
@{ViewData["Title"]=Model.Number;}
<h1>@Model.Number</h1><p>@Model.Email · @Model.Status · @Model.PaymentStatus</p><table><tbody>@foreach(var i in Model.Items){<tr><td>@i.Name @i.Variant</td><td>@i.Quantity × @i.UnitPrice.ToString("N0")</td><td>@i.Total.ToString("N0") Kč</td></tr>}</tbody></table><p>Celkem <strong>@Model.Total.ToString("N0") @Model.Currency</strong></p><form asp-action="Status" method="post"><input type="hidden" name="id" value="@Model.Id"/><select name="status" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select><button type="submit">Změnit stav</button></form>@if(Model.Status is not OrderStatus.Cancelled and not OrderStatus.Shipped and not OrderStatus.Completed){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id"/><button type="submit">Zrušit a vrátit sklad</button></form>}<h2>Historie</h2><ul>@foreach(var h in Model.History){<li>@h</li>}</ul>
