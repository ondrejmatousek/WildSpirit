@model EditProductRequest
@{ViewData["Title"]=Model.Id.HasValue?"Upravit produkt":"Nový produkt";var categories=(IReadOnlyList<EditCategoryRequest>)ViewBag.Categories;var collections=(IReadOnlyList<AdminLookup>)ViewBag.Collections;var materials=(IReadOnlyList<AdminLookup>)ViewBag.Materials;}
<div class="admin-heading"><div><p class="eyebrow">Katalog</p><h1>@ViewData["Title"]</h1></div><a asp-action="Index">Zpět na seznam</a></div><form asp-action="Save" method="post" class="admin-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div>
<section class="admin-card"><h2>Základní údaje</h2><div class="form-grid"><label>SKU<input asp-for="Sku"/></label><label>Kategorie<select asp-for="CategoryId"><option value="">Vyberte</option>@foreach(var c in categories){<option value="@c.Id">@(c.Translations.FirstOrDefault(t=>t.Culture=="cs-CZ")?.Name)</option>}</select></label><label>Kolekce<select asp-for="CollectionId"><option value="">Bez kolekce</option>@foreach(var c in collections){<option value="@c.Id">@c.Name</option>}</select></label><label>Základní cena<input asp-for="BasePrice" type="number" step="0.01"/></label><label>Cena od<input asp-for="StartingPrice" type="number" step="0.01"/></label><label>DPH %<input asp-for="VatRate" type="number" step="0.01"/></label><label>Dostupnost<select asp-for="AvailabilityStatus" asp-items="Html.GetEnumSelectList<AvailabilityStatus>()"></select></label><label>Sklad<input asp-for="StockQuantity" type="number"/></label><label>Doba výroby ve dnech<input asp-for="EstimatedProductionDays" type="number"/></label></div><div class="checks"><label><input asp-for="IsPublished"/> Publikovat</label><label><input asp-for="IsFeatured"/> Doporučené</label><label><input asp-for="IsNew"/> Novinka</label><label><input asp-for="IsLimited"/> Limitované</label><label><input asp-for="TrackInventory"/> Sledovat sklad</label><label><input asp-for="CanBeMadeToOrder"/> Lze znovu vyrobit</label><label><input asp-for="AutomaticallySwitchToMadeToOrder"/> Po vyprodání na objednávku</label><label><input asp-for="HasVariants"/> Produkt má varianty</label></div></section>
<section class="admin-card"><h2>Překlady a SEO</h2>@for(var i=0;i<Model.Translations.Count;i++){<fieldset><legend>@Model.Translations[i].Culture</legend><input asp-for="Translations[i].Culture" type="hidden"/><div class="form-grid"><label>Název<input asp-for="Translations[i].Name"/></label><label>Slug<input asp-for="Translations[i].Slug"/></label><label class="wide">Krátký popis<textarea asp-for="Translations[i].ShortDescription"></textarea></label><label class="wide">Dlouhý popis<textarea asp-for="Translations[i].LongDescription"></textarea></label><label>SEO title<input asp-for="Translations[i].SeoTitle"/></label><label>SEO description<input asp-for="Translations[i].SeoDescription"/></label></div></fieldset>}</section>
<section class="admin-card"><h2>Materiály</h2><div class="checks">@foreach(var m in materials){<label><input type="checkbox" name="MaterialIds" value="@m.Id" checked="@Model.MaterialIds.Contains(m.Id)"/> @m.Name</label>}</div></section>
<section class="admin-card"><h2>Varianty</h2><p>Variantový produkt vede sklad pouze zde.</p><div id="variants">@for(var i=0;i<Model.Variants.Count;i++){<div class="nested-row"><input asp-for="Variants[i].Id" type="hidden"/><label>SKU<input asp-for="Variants[i].Sku"/></label><label>Název CZ<input asp-for="Variants[i].Name"/></label><label>Název EN<input asp-for="Variants[i].NameEn"/></label><label>Název DE<input asp-for="Variants[i].NameDe"/></label><label>Cena<input asp-for="Variants[i].Price" type="number" step="0.01"/></label><label>Sklad<input asp-for="Variants[i].StockQuantity" type="number"/></label><label>Dostupnost<select asp-for="Variants[i].AvailabilityStatus" asp-items="Html.GetEnumSelectList<AvailabilityStatus>()"></select></label></div>}</div><button type="button" class="secondary" data-add-variant>Přidat variantu</button></section>
<section class="admin-card"><h2>Produktové volby</h2><div id="options">@for(var i=0;i<Model.Options.Count;i++){<div class="nested-row"><input asp-for="Options[i].Id" type="hidden"/><label>Název<input asp-for="Options[i].Name"/></label><label>Typ<select asp-for="Options[i].Type" asp-items="Html.GetEnumSelectList<ProductOptionType>()"></select></label><label><input asp-for="Options[i].IsRequired"/> Povinná</label>@for(var j=0;j<Model.Options[i].Values.Count;j++){<input asp-for="Options[i].Values[j].Id" type="hidden"/><label>Hodnota<input asp-for="Options[i].Values[j].Name"/></label><label>Příplatek<input asp-for="Options[i].Values[j].PriceAdjustment" type="number" step="0.01"/></label>}</div>}</div><button type="button" class="secondary" data-add-option>Přidat volbu</button></section>
<div class="form-actions"><button class="button" type="submit">Uložit produkt</button></div></form>
@if(Model.Id.HasValue){<section class="admin-card"><h2>Produktové fotografie</h2><form asp-area="Admin" asp-controller="Media" asp-action="Upload" method="post" enctype="multipart/form-data" class="admin-form"><input type="hidden" name="productId" value="@Model.Id"/><label>Fotografie<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required/></label><label>Alternativní text<input name="altText" maxlength="300" required/></label><label><input type="checkbox" name="isPrimary" value="true"/> Hlavní fotografie</label><button class="button">Nahrát a vytvořit WebP</button></form></section>}
