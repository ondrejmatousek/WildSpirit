<!DOCTYPE html><html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · Wild Spirit Admin</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head><body class="admin-body"><aside class="admin-sidebar"><a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" asp-route-culture="cs-CZ">WILD <span>SPIRIT</span></a><nav><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" asp-route-culture="cs-CZ">Přehled</a><a asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-culture="cs-CZ">Produkty</a><a asp-area="Admin" asp-controller="Categories" asp-action="Index" asp-route-culture="cs-CZ">Kategorie</a><a asp-area="Admin" asp-controller="References" asp-action="Index" asp-route-culture="cs-CZ">Kolekce a materiály</a><a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-culture="cs-CZ">Objednávky</a><a asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="cs-CZ">Zobrazit obchod</a></nav><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Odhlásit</button></form></aside><main class="admin-main"><header class="admin-top"><span>@User.Identity?.Name</span></header>@if(TempData["Success"] is string message){<div class="admin-alert">@message</div>}@RenderBody()</main><script src="~/js/admin.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",false)</body></html>
