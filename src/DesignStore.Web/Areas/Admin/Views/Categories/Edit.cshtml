@model EditCategoryRequest
@{ViewData["Title"]="Kategorie";var categories=(IReadOnlyList<EditCategoryRequest>)ViewBag.Categories;}<div class="admin-heading"><h1>@(Model.Id.HasValue?"Upravit kategorii":"Nová kategorie")</h1></div><form asp-action="Save" method="post" class="admin-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><section class="admin-card"><div class="form-grid"><label>Nadřazená kategorie<select asp-for="ParentCategoryId"><option value="">Bez rodiče</option>@foreach(var c in categories.Where(x=>x.Id!=Model.Id)){<option value="@c.Id">@c.Translations.First().Name</option>}</select></label><label>Pořadí<input asp-for="DisplayOrder" type="number"/></label><label>Obrázek URL<input asp-for="ImageUrl"/></label><label>Banner URL<input asp-for="BannerUrl"/></label><label><input asp-for="IsPublished"/> Publikovat</label></div></section><section class="admin-card">@for(var i=0;i<Model.Translations.Count;i++){<fieldset><legend>@Model.Translations[i].Culture</legend><input asp-for="Translations[i].Culture" type="hidden"/><div class="form-grid"><label>Název<input asp-for="Translations[i].Name"/></label><label>Slug<input asp-for="Translations[i].Slug"/></label><label class="wide">Popis<textarea asp-for="Translations[i].LongDescription"></textarea></label><label>SEO title<input asp-for="Translations[i].SeoTitle"/></label><label>SEO description<input asp-for="Translations[i].SeoDescription"/></label></div></fieldset>}</section><button class="button" type="submit">Uložit kategorii</button></form>
