# Copy to production.env on the server (chmod 600). Never commit the real file.
WILDSPIRIT_DOMAIN=wildspirit.138-2-189-34.sslip.io
WILDSPIRIT_DATA_DIR=/srv/wildspirit/data
# Long random value of letters and digits only (it is inserted into a connection string):
# openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
WILDSPIRIT_DB_PASSWORD=

# First administrator: created on first start if the e-mail does not exist yet.
# Remove both lines after the first successful start (the password is not changed later).
WILDSPIRIT_ADMIN_EMAIL=
WILDSPIRIT_ADMIN_PASSWORD=

# Stripe (test keys sk_test_/whsec_ for a test run). Empty = card payment hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
